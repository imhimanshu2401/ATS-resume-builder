<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ATSPulse AI - Resume Predictor & Builder</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            serif: ['Newsreader', 'Georgia', 'serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              50: '#EEF2FF',
              100: '#E0E7FF',
              500: '#6366F1',
              600: '#4F46E5',
              700: '#4338CA',
            }
          }
        }
      }
    }
  </script>
  <style>
    /* Custom tab transitions and scrollbars */
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    
    .ats-sheet {
      box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.08), 0 2px 6px -1px rgba(15, 23, 42, 0.04);
    }
    
    @keyframes pulse-subtle {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.85; transform: scale(1.03); }
    }
    .animate-pulse-subtle {
      animation: pulse-subtle 3s ease-in-out infinite;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 font-sans min-h-screen antialiased selection:bg-indigo-500 selection:text-white flex flex-col pb-16">

  <!-- TOP APP NAVIGATION BAR (64px) -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200">
    <div class="px-4 h-16 flex items-center justify-between gap-2 max-w-7xl mx-auto w-full">
      <!-- Left: Logo & Brand -->
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white shadow-sm shadow-indigo-200">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
          </svg>
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-1.5">
            <span class="font-bold text-base tracking-tight text-slate-900">ATSPulse</span>
            <span class="px-1.5 py-0.2 rounded text-[10px] font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">AI</span>
          </div>
          <span class="text-[10px] text-slate-400 font-medium hidden sm:inline">Score Predictor & Builder</span>
        </div>
      </div>

      <!-- Right: Action CTA Buttons -->
      <div class="flex items-center gap-2">
        <button id="loadSampleBtn" onclick="loadSampleData()" class="px-2.5 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 active:scale-95 rounded-lg border border-slate-200 transition-all flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
          </svg>
          <span class="hidden xs:inline">Sample Data</span>
          <span class="xs:hidden">Sample</span>
        </button>

        <button onclick="switchView('report')" class="px-3 py-1.5 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 active:scale-95 rounded-lg shadow-sm shadow-indigo-200 transition-all flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          <span>Analyze</span>
        </button>
      </div>
    </div>

    <!-- Segmented Tab Navigation for Mobile & Responsive -->
    <div class="px-3 py-1.5 bg-slate-100/90 border-t border-slate-200">
      <nav class="flex p-1 bg-slate-200/80 rounded-xl text-xs font-medium text-slate-600" aria-label="Tabs">
        <button id="tab-input" onclick="switchView('input')" class="flex-1 py-1.5 px-2 rounded-lg text-center transition-all flex items-center justify-center gap-1.5 bg-white text-indigo-700 font-semibold shadow-xs">
          <span class="w-4 h-4 rounded-full bg-indigo-100 text-indigo-700 text-[10px] font-bold flex items-center justify-center">1</span>
          <span class="truncate">Match Input</span>
        </button>
        <button id="tab-report" onclick="switchView('report')" class="flex-1 py-1.5 px-2 rounded-lg text-center transition-all flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900">
          <span class="w-4 h-4 rounded-full bg-slate-300 text-slate-700 text-[10px] font-bold flex items-center justify-center">2</span>
          <span class="truncate">Score Diagnostic</span>
        </button>
        <button id="tab-builder" onclick="switchView('builder')" class="flex-1 py-1.5 px-2 rounded-lg text-center transition-all flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900">
          <span class="w-4 h-4 rounded-full bg-slate-300 text-slate-700 text-[10px] font-bold flex items-center justify-center">3</span>
          <span class="truncate">ATS Builder</span>
        </button>
      </nav>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="flex-1 max-w-7xl mx-auto w-full p-3 sm:p-5">

    <!-- ========================================== -->
    <!-- VIEW 1: INPUT & MATCH (SPLIT-SCREEN CARDS) -->
    <!-- ========================================== -->
    <div id="view-input" class="space-y-4">
      <!-- Header Banner info -->
      <div class="bg-indigo-50/60 border border-indigo-100 rounded-xl p-3.5 flex items-start gap-3">
        <div class="w-7 h-7 rounded-lg bg-indigo-600 text-white flex-shrink-0 flex items-center justify-center mt-0.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div>
          <h2 class="text-xs font-bold text-slate-900">ATS Parsing Pre-Flight Check</h2>
          <p class="text-[11px] text-slate-600 mt-0.5 leading-relaxed">Simulate enterprise ATS filters (Workday, Greenhouse, Taleo). Paste your target job description and current resume to detect missing keywords and syntax barriers.</p>
        </div>
      </div>

      <!-- Split Grid on Desktop / Stacked on Mobile -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">

        <!-- CARD 1: TARGET JOB OPENING -->
        <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-indigo-600"></span>
                <h3 class="font-bold text-sm text-slate-900">Target Job Opening</h3>
              </div>
              <span class="text-[11px] font-medium text-slate-400 bg-slate-100 px-2 py-0.5 rounded-full">Step 1</span>
            </div>

            <!-- URL Extraction Bar -->
            <div class="mt-3.5">
              <label class="block text-[11px] font-semibold text-slate-700 mb-1.5">Import Directly from Job Board</label>
              <div class="flex gap-2">
                <div class="relative flex-1">
                  <div class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none">
                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                  </div>
                  <input id="jobUrlInput" type="url" placeholder="Paste LinkedIn, Greenhouse, or Lever link..." class="w-full pl-8 pr-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-slate-800 placeholder-slate-400">
                </div>
                <button onclick="extractJobSimulation()" class="px-3 py-2 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-xl transition-all whitespace-nowrap active:scale-95">
                  Extract
                </button>
              </div>
            </div>

            <!-- Divider -->
            <div class="relative my-3 text-center">
              <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-200"></div></div>
              <span class="relative bg-white px-2 text-[10px] font-bold text-slate-400 uppercase tracking-wider">Or Paste Job Description</span>
            </div>

            <!-- Tags / Detected Details -->
            <div id="jobDetectedPills" class="flex flex-wrap items-center gap-1.5 mb-2">
              <span class="text-[10px] text-slate-400 font-medium">Detected:</span>
              <span class="px-2 py-0.5 rounded-md bg-indigo-50 text-indigo-700 text-[10px] font-semibold border border-indigo-100">Senior Product Analyst</span>
              <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 text-[10px] font-medium">Stripe / Fintech</span>
              <span class="px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 text-[10px] font-medium border border-emerald-100">Full-Time</span>
            </div>

            <!-- Large Textarea -->
            <div class="relative">
              <textarea id="jobDescArea" rows="10" placeholder="Paste full job description including requirements, qualifications, and core tech stack..." class="w-full p-3 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all font-mono leading-relaxed text-slate-700 resize-none">Role: Senior Product Analyst (Growth & Retention)
Location: Remote / New York

We are looking for a Senior Product Analyst to drive retention modeling and product telemetry.

Key Qualifications:
• 4+ years of data analysis or product analytics experience in high-growth SaaS.
• Expert proficiency in SQL (window functions, CTEs) and Python or R for data munging.
• Deep experience building executive Tableau & Looker dashboards tracking North Star metrics.
• Proven track record partnering with Product Managers & Engineering on A/B experimentation and cohort retention analysis.
• Expertise in data modeling, dbt, Snowflake, and event tracking schemas (Segment, Amplitude).
• Strong stakeholder management and cross-functional communication.</textarea>
              <div class="flex items-center justify-between text-[10px] text-slate-400 mt-1 px-1">
                <span id="jobDescCount">138 words • 892 characters</span>
                <span class="text-emerald-600 font-medium flex items-center gap-1">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                  18 Critical Keywords Found
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- CARD 2: YOUR CURRENT RESUME -->
        <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                <h3 class="font-bold text-sm text-slate-900">Your Current Resume</h3>
              </div>
              <span class="text-[11px] font-medium text-slate-400 bg-slate-100 px-2 py-0.5 rounded-full">Step 2</span>
            </div>

            <!-- File Upload Dropzone -->
            <div class="mt-3.5 border-2 border-dashed border-slate-200 hover:border-indigo-400 rounded-xl p-3 text-center bg-slate-50/60 hover:bg-indigo-50/20 transition-all cursor-pointer group">
              <div class="flex items-center justify-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-white shadow-xs border border-slate-200 flex items-center justify-center text-slate-500 group-hover:text-indigo-600 transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                </div>
                <div class="text-left">
                  <p class="text-xs font-semibold text-slate-700 group-hover:text-indigo-600"><span class="underline">Click to upload</span> or drag resume</p>
                  <p class="text-[10px] text-slate-400">PDF, DOCX, or TXT (Max 5MB)</p>
                </div>
              </div>
            </div>

            <!-- Formatting & Parser Status indicator -->
            <div class="flex items-center justify-between mt-3 mb-2 px-1">
              <div class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span class="text-[11px] font-semibold text-slate-700">Plain-text parser ready</span>
              </div>
              <button onclick="cleanResumeFormat()" class="text-[10px] font-semibold text-indigo-600 hover:text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded border border-indigo-100">
                ✨ Clean Formatting
              </button>
            </div>

            <!-- Resume Content Textarea -->
            <div class="relative">
              <textarea id="resumeContentArea" rows="10" placeholder="Paste your current resume content here..." class="w-full p-3 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all font-mono leading-relaxed text-slate-700 resize-none">ALEXANDER WRIGHT
alex.wright@email.com • (555) 234-5678 • San Francisco, CA • linkedin.com/in/alexwright

PROFESSIONAL SUMMARY
Data Analyst with 4+ years of experience in product data modeling, SQL query optimization, and executive dashboards. Skilled in deriving actionable insights to improve product conversion and user retention.

EXPERIENCE
Product Analyst | FinScale Technologies (2021 – Present)
• Built multi-touch attribution and weekly conversion dashboards in Tableau used by VP of Product.
• Wrote complex SQL queries across 10M+ transaction tables to identify churn factors.
• Collaborated with engineering to define event taxonomy and tracking schemas for onboarding funnel.

Data Analyst | DataLoop Labs (2019 – 2021)
• Conducted cohort analysis with Python (pandas, numpy) and automated weekly metric reports.
• Reduced dashboard query execution time by 35% through query refactoring and index optimization.

SKILLS
SQL, Python, Tableau, Looker, ETL Pipelines, Cohort Retention, KPI Tracking, Statistical Modeling</textarea>
              <div class="flex items-center justify-between text-[10px] text-slate-400 mt-1 px-1">
                <span id="resumeWordCount">142 words • 1,028 characters</span>
                <span class="text-amber-600 font-medium flex items-center gap-1">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                  5 High-Impact Gaps
                </span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Prominent Bottom Action Bar -->
      <div class="pt-2">
        <button onclick="switchView('report')" class="w-full py-3.5 px-4 bg-indigo-600 hover:bg-indigo-700 active:scale-[0.99] text-white font-bold text-sm rounded-xl shadow-lg shadow-indigo-200 flex items-center justify-center gap-2 transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          <span>Run ATS Match & Score Prediction →</span>
        </button>
        <p class="text-center text-[11px] text-slate-400 mt-2">Tested against Taleo, Greenhouse, Lever, and Workday ATS parsing engines</p>
      </div>
    </div>


    <!-- ========================================== -->
    <!-- VIEW 2: ATS SCORE DIAGNOSTIC DASHBOARD     -->
    <!-- ========================================== -->
    <div id="view-report" class="space-y-4 hidden">
      
      <!-- Top Summary Row (3-Column Grid) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

        <!-- Card 1: Hero Gauge -->
        <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm flex flex-col items-center text-center justify-between">
          <div class="w-full flex items-center justify-between mb-1">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Overall ATS Score</span>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">Strong Contender</span>
          </div>

          <!-- Circular Radial Progress Gauge -->
          <div class="relative w-32 h-32 my-2 flex items-center justify-center">
            <svg class="w-full h-full transform -rotate-90" viewBox="0 0 100 100">
              <circle cx="50" cy="50" r="42" stroke="currentColor" stroke-width="9" class="text-slate-100" fill="transparent"/>
              <circle cx="50" cy="50" r="42" stroke="currentColor" stroke-width="9" class="text-indigo-600 transition-all duration-1000 ease-out" stroke-dasharray="264" stroke-dashoffset="58" stroke-linecap="round" fill="transparent"/>
            </svg>
            <div class="absolute flex flex-col items-center justify-center">
              <span class="text-3xl font-extrabold text-slate-900 tracking-tight">78<span class="text-base text-slate-400 font-normal">/100</span></span>
              <span class="text-[10px] font-semibold text-emerald-600">84th Percentile</span>
            </div>
          </div>

          <p class="text-[11px] text-slate-500 leading-snug mt-1">
            High chance to pass automated screeners. Add <strong>3 missing tech skills</strong> to reach interview threshold (85+).
          </p>
        </div>

        <!-- Card 2: Category Breakdown (Progress Bars) -->
        <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm flex flex-col justify-between">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Category Breakdown</span>
            <span class="text-[10px] text-slate-400 font-mono">4 Vectors</span>
          </div>

          <div class="space-y-2.5">
            <!-- Metric 1 -->
            <div>
              <div class="flex justify-between text-[11px] font-semibold mb-1">
                <span class="text-slate-700">Keyword & Skill Match</span>
                <span class="text-indigo-600 font-bold">82%</span>
              </div>
              <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                <div class="h-full bg-indigo-600 rounded-full" style="width: 82%"></div>
              </div>
            </div>

            <!-- Metric 2 -->
            <div>
              <div class="flex justify-between text-[11px] font-semibold mb-1">
                <span class="text-slate-700">Formatting & Parser Safety</span>
                <span class="text-emerald-600 font-bold">95%</span>
              </div>
              <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                <div class="h-full bg-emerald-500 rounded-full" style="width: 95%"></div>
              </div>
            </div>

            <!-- Metric 3 -->
            <div>
              <div class="flex justify-between text-[11px] font-semibold mb-1">
                <span class="text-slate-700">Quantified Impact & Metrics</span>
                <span class="text-amber-600 font-bold">64%</span>
              </div>
              <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                <div class="h-full bg-amber-500 rounded-full" style="width: 64%"></div>
              </div>
            </div>

            <!-- Metric 4 -->
            <div>
              <div class="flex justify-between text-[11px] font-semibold mb-1">
                <span class="text-slate-700">Role & Seniority Alignment</span>
                <span class="text-indigo-600 font-bold">75%</span>
              </div>
              <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                <div class="h-full bg-indigo-500 rounded-full" style="width: 75%"></div>
              </div>
            </div>
          </div>

          <div class="pt-2 text-[10px] text-slate-400 border-t border-slate-100 flex items-center justify-between">
            <span>ATS Compliance: High</span>
            <span class="text-emerald-600 font-medium">0 Table/Column Errors</span>
          </div>
        </div>

        <!-- Card 3: Quick Action Card -->
        <div class="bg-gradient-to-br from-indigo-900 to-slate-900 text-white border border-indigo-950 rounded-2xl p-4 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-1.5 text-indigo-300 text-[11px] font-semibold uppercase tracking-wider">
              <span class="w-2 h-2 rounded-full bg-indigo-400 animate-ping"></span>
              Optimization Potential
            </div>
            <h4 class="text-base font-bold text-white mt-1">Boost Score to 92/100</h4>
            <p class="text-xs text-slate-300 mt-1.5 leading-relaxed">
              We identified 4 high-impact keywords (Snowflake, dbt, A/B experimentation, Segment) easily injected into your bullet points.
            </p>
          </div>

          <div class="mt-4">
            <button onclick="switchView('builder')" class="w-full py-2.5 px-3 bg-white text-indigo-950 font-bold text-xs rounded-xl hover:bg-slate-100 active:scale-95 transition-all flex items-center justify-center gap-2 shadow-md">
              <span>Fix Issues in ATS Builder</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>
            <span class="block text-center text-[10px] text-indigo-300/80 mt-1.5">Applies single-column ATS format automatically</span>
          </div>
        </div>

      </div>

      <!-- Middle Row: Keyword Gap Analysis (2-Column Grid) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

        <!-- Left: Matched Keywords -->
        <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
          <div class="flex items-center justify-between mb-3">
