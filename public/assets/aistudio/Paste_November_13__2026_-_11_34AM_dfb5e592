      const exp2 = `${document.getElementById('exp2-title').value} - ${document.getElementById('exp2-company').value} (${document.getElementById('exp2-dates').value})\n${document.getElementById('exp2-bullets').value}`;
      const edu = `${document.getElementById('edu-degree').value} - ${document.getElementById('edu-school').value} (${document.getElementById('edu-year').value})\nCertifications: ${document.getElementById('edu-certs').value}`;

      const fullTxt = `${name.toUpperCase()}\n${contact}\n\n====================\nPROFESSIONAL SUMMARY\n====================\n${summary}\n\n====================\nCORE SKILLS\n====================\n${skills}\n\n====================\nWORK EXPERIENCE\n====================\n${exp1}\n\n${exp2}\n\n====================\nEDUCATION & CERTIFICATIONS\n====================\n${edu}`;

      const blob = new Blob([fullTxt], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'Alex_Wright_ATS_Resume.txt';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast('Downloaded plain-text ATS resume (.txt)', '📥');
    }

    // PDF Export Simulation
    function exportPdfSimulation() {
      showToast('Rendering high-fidelity 100% single-column ATS PDF...', '⏳');
      setTimeout(() => {
        window.print();
      }, 600);
    }

    // Initialize character counters & preview on load
    document.addEventListener('DOMContentLoaded', () => {
      updateResumePreview();
    });
  </script>
</body>
